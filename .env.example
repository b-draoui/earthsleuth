# Copy to .env (ignored by Git). Read by common/config.py for every Python part.

# NASA downloads (pipeline/download.py, through earthaccess)
EARTHDATA_USERNAME=your-username
EARTHDATA_PASSWORD=your-password

# 1 = API and agent read data/fake/ instead of data/processed/
EARTHSLEUTH_FAKE=1

# Agent (never commit the real key; on the host, set it as an environment variable)
LLM_API_KEY=paste-key-here
MAX_QUESTIONS_PER_SESSION=5

# Neo4j, development only
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
