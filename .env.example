# Copy to .env (ignored by Git) and fill in. Read by common/config.py for every Python part.
# Never commit .env.

# --- investigator (AI) -------------------------------------------------------------
# Gemini key: steps Understand + Explain. Without it the investigator still runs (rules + templates).
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
# Optional: which Gemini models to use (defaults: gemini-pro-latest / gemini-flash-latest)
GEMINI_MODEL=
GEMINI_FAST_MODEL=
# EXPLAIN_MODEL=pro    # slower, better prose

# --- knowledge graph ---------------------------------------------------------------
# Neo4j Desktop running locally. Leave NEO4J_PASSWORD empty to use data/graph/graph.json instead.
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# 1 = when Neo4j is off, the web app may write new findings back into data/graph/graph.json
EARTHSLEUTH_SAVE_GRAPH=0

# --- NASA downloads (python run.py download) ---------------------------------------
# free account at https://urs.earthdata.nasa.gov, approve "NASA GESDISC DATA ARCHIVE"
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- web app -----------------------------------------------------------------------
# 1 = the app reads data/fake/ (simulated) instead of data/processed/ (real NASA results)
EARTHSLEUTH_FAKE=0
